# @name scanNonExistentQR
POST {{api_url}}/api/mobile/scan HTTP/1.1
Authorization: Bearer {{mobileToken}}
Content-Type: application/json

{
  "qrCode": "00000000-0000-0000-0000-000000000000",
  "petugasId": "{{createPetugas.response.body.$.data.id}}",
  "posId": "{{createPos.response.body.$.data.id}}",
  "tipeScan": "masuk"
}

### 59. Test Scan with Inactive QR
# @name scanInactiveQR
# First create a QR and toggle it to inactive, then try to scan
POST {{api_url}}/api/mobile/scan HTTP/1.1
Authorization: Bearer {{mobileToken}}
Content-Type: application/json

{
  "qrCode": "inactive-qr-uuid-here",
  "petugasId": "{{createPetugas.response.body.$.data.id}}",
  "posId": "{{createPos.response.body.$.data.id}}",
  "tipeScan": "masuk"
}

# =============================================================================
# WORKFLOW EXAMPLES
# =============================================================================

### Workflow 1: Complete User Setup and QR Scan
# @name workflow1

# Step 1: Login as superadmin
POST {{api_url}}/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "{{superadmin_username}}",
  "password": "{{superadmin_password}}"
}

### Workflow 2: Mobile App Flow
# @name workflow2

# Step 1: Authenticate with PIN
POST {{api_url}}/api/mobile/auth/pin HTTP/1.1
Content-Type: application/json

{
  "pin": "{{pin}}"
}

# Step 2: Sync master data
GET {{api_url}}/api/mobile/sync HTTP/1.1
Authorization: Bearer {{mobileToken}}

# Step 3: Scan QR code
POST {{api_url}}/api/mobile/scan HTTP/1.1
Authorization: Bearer {{mobileToken}}
Content-Type: application/json

{
  "qrCode": "{{createQR.response.body.$.data.qrCode}}",
  "petugasId": "{{createPetugas.response.body.$.data.id}}",
  "posId": "{{createPos.response.body.$.data.id}}",
  "tipeScan": "masuk"
}

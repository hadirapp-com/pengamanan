@mobileToken=eyJhbGciOiJIUzI1NiJ9.eyJwZXR1Z2FzSWQiOiJmNDRiZjZjNy04ZGEwLTRlZWMtYTJkNi1kNzkxY2JiMzAyMjIiLCJuYW1hIjoiUGV0dWdhcyBKYWdhIiwidHlwZSI6Im1vYmlsZSIsImlhdCI6MTc3MzQwMjY2MiwiZXhwIjoxNzgxMTc4NjYyfQ.O5Bf6yowTOHQ5TRaH_JvBOOtNa3aKcCkj4CcrgQotW0
# Default credentials (after seeding)
@superadmin_username=superadmin
@superadmin_password=admin123
@pin=123456

# =============================================================================
# AUTHENTICATION ENDPOINTS
# =============================================================================

### 1. Admin Login - Superadmin
# @name loginSuperadmin
POST {{api_url}}/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "{{superadmin_username}}",
  "password": "{{superadmin_password}}"
}

### 2. Get Current User
# @name getCurrentUser
GET {{api_url}}/api/auth/me HTTP/1.1
Authorization: Bearer {{token}}

### 3. Logout
# @name logout
POST {{api_url}}/api/auth/logout HTTP/1.1
Authorization: Bearer {{token}}

### 4. Change Password
# @name changePassword
POST {{api_url}}/api/auth/change-password HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "oldPassword": "{{superadmin_password}}",
  "newPassword": "newPassword123"
}

# =============================================================================
# MOBILE AUTHENTICATION (PIN-based)
# =============================================================================

### 5. Mobile PIN Login
# @name mobilePinLogin
POST {{api_url}}/api/mobile/auth/pin HTTP/1.1
Content-Type: application/json

{
  "pin": "{{pin}}"
}

# =============================================================================
# MOBILE SCAN ENDPOINT (NEW - Single Scan)
# =============================================================================

### 6. Mobile Single QR Scan
# @name mobileSingleScan
POST {{api_url}}/api/mobile/scan HTTP/1.1
Authorization: Bearer {{mobileToken}}
Content-Type: application/json

{
  "qrCode": "uuid-qr-code-here",
  "petugasId": "uuid-petugas-here",
  "posId": "uuid-pos-here",
  "tipeScan": "masuk"
}

### 7. Mobile Single QR Scan - Test Validation Error
# @name mobileScanValidationError
POST {{api_url}}/api/mobile/scan HTTP/1.1
Authorization: Bearer {{mobileToken}}
Content-Type: application/json

{
  "qrCode": "",
  "petugasId": "invalid-uuid",
  "posId": "",
  "tipeScan": "masuk"
}

# =============================================================================
# USER MANAGEMENT (Superadmin only)
# =============================================================================

### 8. List Users with Pagination
# @name listUsers
GET {{api_url}}/api/users?page=1&perPage=10 HTTP/1.1
Authorization: Bearer {{token}}

### 9. Create User (Superadmin only)
# @name createUser
POST {{api_url}}/api/users HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "testuser",
  "password": "password123",
  "role": "admin"
}

### 10. Get User Detail
# @name getUserDetail
GET {{api_url}}/api/users/{{createUser.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 11. Update User
# @name updateUser
PUT {{api_url}}/api/users/{{createUser.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "testuser_updated",
  "role": "admin"
}

### 12. Delete User (Soft Delete)
# @name deleteUser
DELETE {{api_url}}/api/users/{{createUser.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 13. Reset User Password
# @name resetUserPassword
POST {{api_url}}/api/users/{{createUser.response.body.$.data.id}}/reset-password HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newPassword": "newPassword456"
}

# =============================================================================
# PETUGAS JAGA MANAGEMENT
# =============================================================================

### 14. List Petugas Jaga
# @name listPetugas
GET {{api_url}}/api/petugas?page=1&perPage=10&isActive=true HTTP/1.1
Authorization: Bearer {{token}}

### 15. Create Petugas Jaga
# @name createPetugas
POST {{api_url}}/api/petugas HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama": "Bpk. Test Petugas",
  "nik": "1234567890123458",
  "noHp": "081234567899"
}

### 16. Get Petugas Detail
# @name getPetugasDetail
GET {{api_url}}/api/petugas/{{createPetugas.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 17. Update Petugas Jaga
# @name updatePetugas
PUT {{api_url}}/api/petugas/{{createPetugas.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama": "Bpk. Test Petugas Updated",
  "nik": "1234567890123458",
  "noHp": "081234567899",
  "isActive": true
}

### 18. Delete Petugas Jaga (Soft Delete)
# @name deletePetugas
DELETE {{api_url}}/api/petugas/{{createPetugas.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

# =============================================================================
# POS JAGA MANAGEMENT
# =============================================================================

### 19. List Pos Jaga
# @name listPos
GET {{api_url}}/api/pos?page=1&perPage=10&isActive=true HTTP/1.1
Authorization: Bearer {{token}}

### 20. Create Pos Jaga
# @name createPos
POST {{api_url}}/api/pos HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama": "Pos Test",
  "lokasi": "Lokasi Test"
}

### 21. Get Pos Detail
# @name getPosDetail
GET {{api_url}}/api/pos/{{createPos.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 22. Update Pos Jaga
# @name updatePos
PUT {{api_url}}/api/pos/{{createPos.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama": "Pos Test Updated",
  "lokasi": "Lokasi Test Updated",
  "isActive": true
}

### 23. Delete Pos Jaga (Soft Delete)
# @name deletePos
DELETE {{api_url}}/api/pos/{{createPos.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

# =============================================================================
# QR CODE MANAGEMENT
# =============================================================================

### 24. List QR Codes
# @name listQR
GET {{api_url}}/api/qr?page=1&perPage=10&isActive=true HTTP/1.1
Authorization: Bearer {{token}}

### 25. Create QR Code
# @name createQR
POST {{api_url}}/api/qr HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama": "Block Test-101",
  "penanggungJawab": "Bpk. Test Owner",
  "validFrom": "2026-03-10",
  "validUntil": "2026-04-10"
}

### 26. Get QR Detail
# @name getQRDetail
GET {{api_url}}/api/qr/{{createQR.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 27. Update QR Code
# @name updateQR
PUT {{api_url}}/api/qr/{{createQR.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama": "Block Test-101 Updated",
  "penanggungJawab": "Bpk. Test Owner",
  "validFrom": "2026-03-10",
  "validUntil": "2026-04-10",
  "isActive": true
}

### 28. Generate New QR UUID
# @name generateQR
POST {{api_url}}/api/qr/generate HTTP/1.1
Authorization: Bearer {{token}}

### 29. Download QR Image (PNG)
# @name getQRImage
GET {{api_url}}/api/qr/{{createQR.response.body.$.data.id}}/image HTTP/1.1
Authorization: Bearer {{token}}

### 30. Generate PDF for Multiple QR
# @name generateQRPDF
POST {{api_url}}/api/qr/pdf HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "qrIds": ["{{createQR.response.body.$.data.id}}"]
}

### 31. Activate/Deactivate QR
# @name toggleQR
PATCH {{api_url}}/api/qr/{{createQR.response.body.$.data.id}}/toggle HTTP/1.1
Authorization: Bearer {{token}}

### 32. Delete QR Code (Soft Delete)
# @name deleteQR
DELETE {{api_url}}/api/qr/{{createQR.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

# =============================================================================
# PENGUMUMAN MANAGEMENT
# =============================================================================

### 33. List Pengumuman
# @name listPengumuman
GET {{api_url}}/api/pengumuman?page=1&perPage=10&isActive=true HTTP/1.1
Authorization: Bearer {{token}}

### 34. Create Pengumuman
# @name createPengumuman
POST {{api_url}}/api/pengumuman HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Test Pengumuman",
  "content": "This is a test pengumuman content",
  "priority": "normal"
}

### 35. Get Pengumuman Detail
# @name getPengumumanDetail
GET {{api_url}}/api/pengumuman/{{createPengumuman.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 36. Update Pengumuman
# @name updatePengumuman
PUT {{api_url}}/api/pengumuman/{{createPengumuman.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Test Pengumuman Updated",
  "content": "This is a test pengumuman content updated",
  "priority": "important",
  "isActive": true
}

### 37. Delete Pengumuman (Soft Delete)
# @name deletePengumuman
DELETE {{api_url}}/api/pengumuman/{{createPengumuman.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

# =============================================================================
# MOBILE SYNC ENDPOINTS (Requires Mobile JWT Token)
# =============================================================================

### 38. Mobile Sync - Get All Master Data
# @name mobileSync
GET {{api_url}}/api/mobile/sync HTTP/1.1
Authorization: Bearer {{mobileToken}}

### 39. Mobile Get Pengumuman
# @name mobileGetPengumuman
GET {{api_url}}/api/mobile/pengumuman HTTP/1.1
Authorization: Bearer {{mobileToken}}

### 40. Mobile Sync Scan Logs (Batch)
# @name mobileSyncLogs
POST {{api_url}}/api/mobile/sync-logs HTTP/1.1
Authorization: Bearer {{mobileToken}}
Content-Type: application/json

{
  "logs": [
    {
      "qrCode": "{{createQR.response.body.$.data.qrCode}}",
      "petugasId": "{{createPetugas.response.body.$.data.id}}",
      "posId": "{{createPos.response.body.$.data.id}}",
      "tipeScan": "masuk",
      "scannedAt": "2026-03-10T14:30:25.000Z"
    }
  ]
}

### 41. Mobile Mark Pengumuman as Read
# @name mobileReadAnnounce
POST {{api_url}}/api/mobile/read-announce HTTP/1.1
Authorization: Bearer {{mobileToken}}
Content-Type: application/json

{
  "pengumumanIds": ["{{createPengumuman.response.body.$.data.id}}"],
  "deviceId": "test-device-123"
}

# =============================================================================
# LOGS & REPORTING
# =============================================================================

### 42. List Scan Logs with Filters
# @name listLogs
GET {{api_url}}/api/logs?page=1&perPage=10&dateFrom=2026-03-01&dateTo=2026-03-31 HTTP/1.1
Authorization: Bearer {{token}}

### 43. List Scan Logs by Pos
# @name listLogsByPos
GET {{api_url}}/api/logs?posId={{createPos.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 44. List Scan Logs by Petugas
# @name listLogsByPetugas
GET {{api_url}}/api/logs?petugasId={{createPetugas.response.body.$.data.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 45. List Scan Logs by Tipe Scan
# @name listLogsByTipe
GET {{api_url}}/api/logs?tipeScan=masuk HTTP/1.1
Authorization: Bearer {{token}}

### 46. Get Dashboard Statistics
# @name getStats
GET {{api_url}}/api/logs/stats HTTP/1.1
Authorization: Bearer {{token}}

### 47. Export Logs to Excel
# @name exportLogs
GET {{api_url}}/api/logs/export?dateFrom=2026-03-01&dateTo=2026-03-31 HTTP/1.1
Authorization: Bearer {{token}}

### 48. Delete Log Entry
# @name deleteLog
DELETE {{api_url}}/api/logs/{log-id} HTTP/1.1
Authorization: Bearer {{token}}

# =============================================================================
# CONFIGS MANAGEMENT

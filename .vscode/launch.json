{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "name": "🔴 Debug Bun (Dev)",
      "request": "launch",
      // "runtimeExecutable": "bun",
      "runtimeArgs": ["--inspect", "src/index.ts"],
      "cwd": "${workspaceFolder}/api",
      // "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      // "skipFiles": ["<node_internals>/**", "node_modules/**"]
    },
    {
      "type": "node",
      "name": "🔴 Debug Bun (with hot reload) - RECOMMENDED",
      "request": "launch",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--inspect", "--hot", "src/index.ts"],
      "cwd": "${workspaceFolder}/api",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node",
      "name": "🔌 Attach to Bun (already running)",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "localRoot": "${workspaceFolder}/api",
      "remoteRoot": "${workspaceFolder}/api"
    },
    {
      "type": "node-terminal",
      "name": "▶️ Run without Debugging",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}/api"
    }
  ]
}
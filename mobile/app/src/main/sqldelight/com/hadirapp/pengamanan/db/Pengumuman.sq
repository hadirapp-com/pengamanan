CREATE TABLE Pengumuman (
    id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    priority TEXT NOT NULL,
    createdAt TEXT NOT NULL,
    updatedAt TEXT NOT NULL
);

selectAllPengumuman:
SELECT * FROM Pengumuman
ORDER BY createdAt DESC;

selectPengumumanById:
SELECT * FROM Pengumuman WHERE id = ?;

insertPengumuman:
INSERT OR REPLACE INTO Pengumuman (id, title, content, priority, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?);

deletePengumuman:
DELETE FROM Pengumuman WHERE id = ?;

deleteAllPengumuman:
DELETE FROM Pengumuman;

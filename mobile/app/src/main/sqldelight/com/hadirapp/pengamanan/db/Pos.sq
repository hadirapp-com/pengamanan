CREATE TABLE Pos (
    id TEXT PRIMARY KEY,
    nama TEXT NOT NULL,
    lokasi TEXT NOT NULL,
    createdAt TEXT NOT NULL,
    updatedAt TEXT NOT NULL
);

selectAllPos:
SELECT * FROM Pos
ORDER BY nama;

selectPosById:
SELECT * FROM Pos WHERE id = ?;

insertPos:
INSERT OR REPLACE INTO Pos (id, nama, lokasi, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?);

deletePos:
DELETE FROM Pos WHERE id = ?;

deleteAllPos:
DELETE FROM Pos;
